{
  "name": "satisfactory-heat-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/dev-start.mjs",
    "dev": "vite",
    "build": "node scripts/map-ensure-tiles.mjs && tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "node scripts/clean.mjs",
    "map:generate": "node scripts/map-generate.mjs",
    "map:pack": "node scripts/map-pack.mjs",
    "map:ensure": "node scripts/map-ensure-tiles.mjs",
    "map:clean": "node scripts/map-clean.mjs",
    "parse-docs": "node scripts/parse-docs.mjs",
    "wasm:build": "node scripts/wasm-build.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@rolldown/plugin-babel": "^0.1.7",
    "@tailwindcss/vite": "^4.1.13",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
