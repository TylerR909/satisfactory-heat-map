# Dependencies / build outputs (image runs its own npm ci / tile gen)
node_modules
dist
dist-ssr
coverage
dev-dist
map-source
dist-map-tiles
# Host-generated tiles optional; image always regenerates in tiles stage
public/map/v1/**
!public/map/v1/README.md

# Git / IDE / local
.git
.github
.vscode
.idea
*.local
.DS_Store

# Large / private source dumps (never bake into the image)
data/Docs
data/Persistent_Level.json
data/map

# Docs & dev-only (not needed for static serve)
docs
*.md
!README.md
!public/map/v1/README.md

# Tests / tooling noise
**/*.test.ts
**/*.test.tsx
vitest.config.*
biome.json
tsconfig*.json
# keep tsconfigs needed for build:
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json

# Env / logs
logs
*.log
.env
.env.*
